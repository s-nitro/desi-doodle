{
  "rules": {
    "rooms": {
      "$room": {
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "state":    { ".read": "auth != null", ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists()" },
        "settings": { ".read": "auth != null", ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists()" },
        "scores":   { ".read": "auth != null", ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists()" },
        "draw":     { ".read": "auth != null", ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists()" },
        "chat": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
          "$msg": { ".validate": "newData.child('t').isString() && newData.child('t').val().length <= 160" }
        },
        "guesses": {
          ".read": "auth != null && root.child('rooms').child($room).child('state').child('drawerId').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists()"
        },
        "secret": {
          ".read": "auth != null && root.child('rooms').child($room).child('state').child('drawerId').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($room).child('state').child('drawerId').val() === auth.uid"
        }
      }
    }
  }
}
